  "reputation": {
    "initial": 1,
    "floor": 0.5,
    "ceiling": 1.3,
    "onTimeMeetingRequirements": 0.04,
    "lateMeetingRequirements": -0.02,
    "deliveredMissingRequirement": -0.15,
    "note": "口碑系数 R 乘进月成交量；首轮计算固定为 1，接入订单流程后再启用"
  },
  "priceAcceptance": {
    "formula": "ratio = price / reference; below reference: clamp(1 + belowSlope*(1-ratio), 1, ceiling); above reference: clamp(1 - aboveSlope*(ratio-1), floor, 1)",
    "marketReferencePrice": "midpoint of the archetype budget range",
    "aboveSlopeBySegment": {
      "mass": 4,
      "bespoke": 3
    },
    "belowSlope": 2,
    "floor": 0.1,
    "ceiling": 1.3,
    "budgetCeiling": "A price above the archetype budget maximum never sells, whatever the acceptance value.",
    "note": "斜率按细分市场标定：量产客群极度价格敏感（现实里大厂毛利被压到 13%），高定客群对价格不敏感。斜率取值保证有效贡献在接近市场参考价处最高，加价不能无脑赚钱"
  },
  "fit": {
    "formula": "clamp(actualUseCaseScore / expectedScore, 0, 1)",
    "note": "用途适配 F 只看得分；硬性要求不满足时订单直接不成交，不由 F 补偿"
  },
  "monthlyVolume": {
    "source": "design/economy-candidate.json companyDemandCaps",
    "splitRule": "Each segment's monthly cap is split across its archetypes in proportion to weight."
  }
}
